# Supabase — from your Supabase project dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[your-project-id].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here  # Never expose to client

# Gemini — from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Stripe — from Stripe Dashboard → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_your_key_here          # Use sk_test_ for local dev
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here      # Set after running Stripe CLI
STRIPE_PRO_PRICE_ID=price_your_price_id_here      # Create in Stripe Dashboard
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# AdSense — from AdSense dashboard (leave blank for local dev)
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXXX

# App URL — used for Stripe redirect URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
